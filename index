<!DOCTYPE html> 
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم المروج v2.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-database-compat.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap');
        body { background: #f8fafc; font-family: 'Cairo', sans-serif; }
        .hidden { display: none !important; }
        .ltr { direction: ltr; text-align: left; }
    </style>
</head>
<body>

    <div id="login-page" class="min-h-screen flex items-center justify-center p-6">
        <div class="bg-white p-8 rounded-[2.5rem] shadow-2xl w-full max-w-md border border-slate-100 text-center">
            <div class="bg-blue-600 w-20 h-20 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-blue-200">
                <i class="fas fa-user-shield text-white text-3xl"></i>
            </div>
            <h2 class="text-2xl font-black text-slate-800 mb-2">نظام إدارة المروجين</h2>
            <p class="text-slate-400 mb-8 text-sm">سجل دخولك للوصول إلى أدواتك</p>
            <input type="email" id="email" placeholder="البريد الإلكتروني" class="w-full p-4 mb-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500 text-center font-bold">
            <input type="password" id="password" placeholder="كلمة المرور" class="w-full p-4 mb-6 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500 text-center font-bold">
            <button id="loginBtn" class="w-full bg-blue-600 text-white font-black py-4 rounded-2xl shadow-xl hover:scale-[1.02] transition-all">دخول المنصة</button>
        </div>
    </div>

    <div id="dashboard" class="hidden min-h-screen pb-12">
        <div class="bg-white p-5 shadow-sm flex justify-between items-center px-8 border-b border-slate-100 sticky top-0 z-50">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 text-white p-2 rounded-xl"><i class="fas fa-rocket"></i></div>
                <span class="font-black text-slate-700">لوحة تحكم المروج</span>
            </div>
            <button id="logoutBtn" class="text-red-500 font-bold bg-red-50 px-5 py-2 rounded-2xl hover:bg-red-100 transition">خروج</button>
        </div>

        <div class="p-6 max-w-lg mx-auto space-y-6">
            
            <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100 text-right">
                <span class="text-slate-500 text-sm">مرحباً بك مجدداً،</span>
                <h4 id="user-display-name" class="text-blue-700 font-black text-lg">تحميل...</h4>
            </div>

            <div class="bg-slate-900 p-8 rounded-[2.5rem] shadow-2xl text-white relative overflow-hidden">
                <div class="absolute -top-10 -right-10 bg-blue-600 w-32 h-32 rounded-full opacity-20"></div>
                <h4 class="font-black mb-4 flex items-center gap-2 text-lg">
                    <i class="fas fa-share-alt text-blue-400"></i> رابط الترويج الخاص بك
                </h4>
                <p class="text-xs text-slate-400 mb-6 leading-relaxed">انسخ الرابط أدناه وانشره. سيتم احتساب كل نقرة في رصيدك فوراً.</p>
                <div class="flex flex-col gap-3">
                    <input type="text" id="referral-link" readonly class="w-full bg-slate-800 border border-slate-700 rounded-2xl p-4 text-xs text-blue-300 outline-none ltr font-mono">
                    <button onclick="copyLink()" class="w-full bg-white text-slate-900 font-black py-4 rounded-2xl hover:bg-blue-50 transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="far fa-copy"></i> نسخ الرابط الآن
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white p-6 rounded-[2rem] shadow-sm border-b-8 border-emerald-500">
                    <p class="text-xs text-slate-400 font-bold mb-2">أرباح اليوم</p>
                    <h3 id="today-earnings" class="text-2xl font-black text-slate-800">$0.00</h3>
                </div>
                <div class="bg-white p-6 rounded-[2rem] shadow-sm border-b-8 border-blue-500">
                    <p class="text-xs text-slate-400 font-bold mb-2">إجمالي الأرباح</p>
                    <h3 id="total-earnings" class="text-2xl font-black text-slate-800">$0.00</h3>
                </div>
            </div>

            <div class="bg-white p-8 rounded-[2rem] shadow-sm flex items-center justify-between border border-slate-50">
                <div>
                    <p class="text-slate-400 text-xs font-bold">إجمالي النقرات</p>
                    <h3 id="clicks" class="text-5xl font-black text-slate-800 mt-2">0</h3>
                </div>
                <div class="bg-blue-50 p-6 rounded-3xl text-blue-600">
                    <i class="fas fa-mouse-pointer text-3xl"></i>
                </div>
            </div>

            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                <h4 class="font-black text-slate-800 mb-6 flex items-center gap-2">
                    <i class="fas fa-wallet text-blue-600"></i> طلب سحب رصيد
                </h4>
                <div class="space-y-4">
                    <select id="withdraw-method" class="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none font-bold">
                        <option value="zain_cash">زين كاش (ZainCash)</option>
                        <option value="bank">حوالة بنكية</option>
                        <option value="usdt">USDT (Crypto)</option>
                    </select>
                    <input type="number" id="withdraw-amount" placeholder="حدد المبلغ بالدولار" class="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none text-center font-black text-xl">
                    <button onclick="requestWithdraw()" class="w-full bg-blue-600 text-white font-black py-5 rounded-2xl hover:bg-blue-700 transition shadow-lg">تأكيد طلب السحب</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const firebaseConfig = {
          apiKey: "AIzaSyBf5F5vhbpu8fjp4rS9M-Uj-gUPR88qbds",
          authDomain: "my-site-6f7ff.firebaseapp.com",
          databaseURL: "https://my-site-6f7ff-default-rtdb.firebaseio.com",
          projectId: "my-site-6f7ff",
          storageBucket: "my-site-6f7ff.firebasestorage.app",
          messagingSenderId: "171038692625",
          appId: "1:171038692625:web:4f5d02855d65aef7a768b0"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.database();

        auth.onAuthStateChanged(user => {
            if (user) {
                document.getElementById('login-page').classList.add('hidden');
                document.getElementById('dashboard').classList.remove('hidden');
                
                // استخراج اسم المروج من الإيميل
                const username = user.email.split('@')[0];
                document.getElementById('user-display-name').innerText = username;
                
                // تحديث الرابط التسويقي فوراً
                const currentUrl = window.location.origin;
                document.getElementById('referral-link').value = currentUrl + "/go.html?id=" + username;
                
                loadData(username);
            } else {
                document.getElementById('login-page').classList.remove('hidden');
                document.getElementById('dashboard').classList.add('hidden');
            }
        });

        document.getElementById('loginBtn').onclick = () => {
            const email = document.getElementById('email').value;
            const pass = document.getElementById('password').value;
            auth.signInWithEmailAndPassword(email, pass).catch(err => alert("فشل الدخول: " + err.message));
        };

        document.getElementById('logoutBtn').onclick = () => auth.signOut();

        function loadData(username) {
            db.ref('users_data/' + username).on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    document.getElementById('total-earnings').innerText = '$' + (data.earnings || '0.00');
                    document.getElementById('today-earnings').innerText = '$' + (data.today_earnings || '0.00');
                    document.getElementById('clicks').innerText = data.clicks || '0';
                }
            });
        }

        function copyLink() {
            const linkField = document.getElementById('referral-link');
            linkField.select();
            document.execCommand('copy');
            alert("تم نسخ رابطك بنجاح! يمكنك الآن مشاركته والبدء بالربح.");
        }

        function requestWithdraw() {
            const amount = document.getElementById('withdraw-amount').value;
            if(!amount || amount <= 0) return alert("يرجى كتابة مبلغ صحيح");
            alert("تم إرسال طلب السحب للإدارة. سيتم تحويل المبلغ فور مراجعته.");
        }
    </script>
</body>
</html>

